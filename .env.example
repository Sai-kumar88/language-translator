# Application Settings
APP_NAME="Language Translator API"
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=
CORS_ORIGINS=["*"]

# Translation Limits & Defaults
MAX_TEXT_LENGTH=150000
CHUNK_SIZE=2500
DEFAULT_SOURCE_LANGUAGE=en
TRANSLATION_TIMEOUT_SECONDS=60.0

# Translation Provider Configuration
# Supported providers: googletrans
TRANSLATION_PROVIDER=googletrans
GOOGLETRANS_SERVICE_URLS=["translate.google.com","translate.googleapis.com"]
