            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/translate/document/download",
          "host": ["{{baseUrl}}"],
          "path": ["translate", "document", "download"]
        },
        "description": "Translate an uploaded document and download the translated result as a .docx Word document."
      },
      "response": []
    }
