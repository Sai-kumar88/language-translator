{
  "info": {
    "name": "Language Translator API - VAPS Technosoft",
    "_postman_id": "a4d33a1e-84b2-4d23-95cf-01fa9541a021",
    "description": "API collection for VAPS Technosoft English-to-Indian Regional Language Translator API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Verify API service availability."
      },
      "response": []
    },
    {
      "name": "Get Supported Languages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/languages",
          "host": ["{{baseUrl}}"],
          "path": ["languages"]
        },
        "description": "Fetch all supported Indian regional languages."
      },
      "response": []
    },
    {
      "name": "Translate - English to Kannada",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Welcome to our school\",\n  \"source_language\": \"en\",\n  \"target_language\": \"kn\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/translate",
          "host": ["{{baseUrl}}"],
          "path": ["translate"]
        },
        "description": "Translate text to Kannada (kn)."
      },
      "response": []
    },
