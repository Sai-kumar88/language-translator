    {
      "name": "Translate Document (Word docx, PDF, txt)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "source_language",
              "value": "en",
              "type": "text"
            },
            {
              "key": "target_language",
              "value": "kn",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/translate/document",
          "host": ["{{baseUrl}}"],
          "path": ["translate", "document"]
        },
        "description": "Upload a Word document (.docx), PDF (.pdf), or Text (.txt) file to translate."
      },
      "response": []
    },
    {
      "name": "Translate Document and Download (.docx)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "source_language",
              "value": "en",
              "type": "text"
            },
            {
              "key": "target_language",
